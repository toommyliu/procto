{
  "name": "@procto/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter @procto/web dev",
    "dev:backend": "pnpm --filter @procto/backend dev",
    "dev:convex": "pnpm --filter @procto/backend convex:dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "eslint": "^9.16.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3"
  }
}
